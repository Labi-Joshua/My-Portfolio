---
import Layout from '../../layouts/Layout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import { getCaseStudies } from '../../data/projects';
import { getSiteSettings } from '../../data/settings';
import { optimizeImage } from '../../lib/image';

const { slug } = Astro.params;
const [caseStudies, settings] = await Promise.all([getCaseStudies(), getSiteSettings()]);
const project = caseStudies.find(p => p.slug === slug);

if (!project) return Astro.redirect('/404');

const projectTitle = project.title.replace('\n', ' ');
const emailSubject = encodeURIComponent('Interested in working together');
const emailBody = encodeURIComponent(`Hi Joshua, I saw your ${projectTitle} case study and I'd like to talk about a project.`);
const emailHref = `mailto:jospecial34@gmail.com?subject=${emailSubject}&body=${emailBody}`;
const projectDescription = project.description;

const projectIndex = caseStudies.findIndex(p => p.slug === project.slug) + 1;
const indexLabel = String(projectIndex).padStart(2, '0');

const otherCaseStudy = caseStudies.find(p => p.slug !== project.slug);

const creativeWorkJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: projectTitle,
  description: projectDescription,
  creator: {
    '@type': 'Person',
    name: 'Labi Joshua',
    url: 'https://labijoshua.com',
  },
  image: project.coverImage,
  url: `https://labijoshua.com/work/${project.slug}`,
  ...(project.websiteUrl ? { mainEntityOfPage: project.websiteUrl } : {}),
};
---

<Layout
  title={`${projectTitle} — Joshua Owolabi`}
  description={projectDescription}
  ogImage={project.coverImage}
  ogImageAlt={project.coverAlt}
  ogType="article"
  showNav={false}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(creativeWorkJsonLd)} />

  <!-- Go back: fixed pill, aligned to the max-width container -->
  <div class="fixed top-5 md:top-6 inset-x-0 z-[60] px-6 md:px-12 max-w-[1100px] mx-auto w-full flex justify-end pointer-events-none">
    <a
      href="/"
      class="pointer-events-auto flex items-center gap-1 rounded-full bg-black/25 backdrop-blur-lg border border-white/20 shadow-lg p-1.5 mt-4 md:m-4 text-white text-sm font-medium hover:bg-black/35 transition-colors"
    >
      <span class="flex items-center justify-center w-10 h-10 rounded-full bg-white/10 border border-white/20 shrink-0">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M12 7H2M2 7L6 3M2 7L6 11" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="pr-4 whitespace-nowrap">Go Back</span>
    </a>
  </div>

  <div class="flex flex-col gap-8 pt-[124px] pb-20 px-6 md:px-12 max-w-[1100px] mx-auto w-full">

    <!-- Intro: eyebrow, title, description, CTAs -->
    <div>
      <div class="flex items-center gap-3">
        <div class="flex items-center justify-center w-9 h-9 rounded-full border border-neutral-300 text-xs text-neutral-600 shrink-0">{indexLabel}</div>
        <div class="flex flex-col">
          {project.category && <span class="text-sm font-semibold text-neutral-900">{project.category}</span>}
          {project.featured && <span class="text-xs text-neutral-400">Featured Case Study</span>}
        </div>
      </div>

      <h1 class="font-serif text-3xl md:text-4xl font-normal leading-snug text-neutral-900 whitespace-pre-line mt-6">{project.title}</h1>
      {projectDescription && <p class="text-neutral-500 leading-relaxed mt-3 max-w-2xl">{projectDescription}</p>}

      {(project.websiteUrl || project.appStoreUrl) && (
        <div class="flex items-center gap-3 mt-6">
          {project.websiteUrl && (
            <a
              href={project.websiteUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-neutral-900 text-white px-5 py-3.5 text-sm font-medium"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0">
                <circle cx="7" cy="7" r="5.5" stroke="currentColor" stroke-width="1.2"/>
                <path d="M1.5 7h11M7 1.5c1.4 1.5 2.2 3.5 2.2 5.5S8.4 12.5 7 14c-1.4-1.5-2.2-3.5-2.2-5.5S5.6 3 7 1.5z" stroke="currentColor" stroke-width="1.2"/>
              </svg>
              Visit Website
            </a>
          )}
          {project.appStoreUrl && (
            <a
              href={project.appStoreUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-neutral-900 text-white px-5 py-3.5 text-sm font-medium"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="shrink-0">
                <path d="M9.5 2.2c.5-.6 1.3-1 2-1 .1.8-.2 1.6-.7 2.2-.5.6-1.3 1-2 .9-.1-.7.2-1.5.7-2.1z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
                <path d="M11.7 9.6c-.3.7-.5 1-.9 1.6-.6.9-1.4 2-2.4 2-.9 0-1.2-.6-2.2-.6s-1.3.6-2.2.6c-1 0-1.7-1-2.4-1.9C.4 9.6 0 7.3.9 5.9c.6-1 1.6-1.6 2.5-1.6.9 0 1.5.6 2.2.6s1.4-.7 2.4-.6c.4 0 1.6.2 2.4 1.3-.1.1-1.4.8-1.4 2.3 0 1.8 1.6 2.4 1.7 2.4z" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
              </svg>
              App Store
            </a>
          )}
        </div>
      )}
    </div>

    <!-- Hero preview image(s) -->
    {project.previewImages?.length > 0 && (
      project.previewImages[1] ? (
        <div class="relative w-full rounded-3xl bg-card overflow-hidden" style="aspect-ratio: 2.6 / 1; min-height: 224px;">
          <div class="absolute rounded-xl overflow-hidden shadow-lg bg-white" style="width: 55%; right: 4%; top: 20%; z-index: 1;">
            <img src={optimizeImage(project.previewImages[1].src, 700)} alt="" class="w-full h-full object-cover" loading="eager" decoding="async" />
          </div>
          <div class="absolute overflow-hidden bg-white" style="width: 58%; left: 6%; top: 28%; z-index: 2; border-radius: 0.75rem; box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);">
            <img
              src={optimizeImage(project.previewImages[0].src, 700)}
              alt={project.previewImages[0].alt}
              class="w-full h-full object-cover"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      ) : (
        <img
          src={optimizeImage(project.previewImages[0].src, 1100)}
          alt={project.previewImages[0].alt}
          class="w-full h-auto rounded-3xl"
          loading="eager"
          decoding="async"
        />
      )
    )}

    <!-- Quick stats -->
    {project.quickStats?.length > 0 && (
      <div class="flex flex-col md:flex-row gap-4">
        {project.quickStats.map(stat => (
          <div class="rounded-2xl bg-card p-6 md:flex-1 md:min-w-0">
            <p class="text-xs text-neutral-400 uppercase tracking-widest mb-2">{stat.label}</p>
            <p class="font-serif text-xl text-neutral-900">{stat.value}</p>
          </div>
        ))}
      </div>
    )}

    <!-- The Challenge -->
    {project.challenge?.body && (
      <div class="rounded-3xl bg-card p-8 flex flex-col gap-5">
        <h3 class="flex items-center gap-2 text-[13px] font-medium text-green-dark">
          <span class="w-2 h-2 rounded-sm bg-green-dark shrink-0"></span>
          The Challenge
        </h3>
        <p class="text-neutral-900 leading-relaxed text-base">{project.challenge.body}</p>
        {project.challenge.bullets?.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4 mt-2">
            {project.challenge.bullets.map(bullet => (
              <div class="flex items-start gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-neutral-300 shrink-0 mt-2"></span>
                <span class="text-sm text-neutral-500 leading-relaxed">{bullet}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    )}

    <!-- My Role + What I Worked On -->
    {((project.roleTags?.length ?? 0) > 0 || (project.workedOn?.length ?? 0) > 0) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {project.roleTags?.length > 0 && (
          <div class="rounded-2xl bg-card p-6">
            <h4 class="flex items-center gap-2 text-[13px] font-medium text-green-dark mb-4">
              <span class="w-2 h-2 rounded-sm bg-green-dark shrink-0"></span>
              My Role
            </h4>
            <div class="flex flex-wrap gap-3">
              {project.roleTags.map(tag => (
                <span class="text-sm text-neutral-600 bg-white rounded-full px-5 py-3 border border-neutral-200">{tag}</span>
              ))}
            </div>
          </div>
        )}
        {project.workedOn?.length > 0 && (
          <div class="rounded-2xl bg-card p-6">
            <h4 class="flex items-center gap-2 text-[13px] font-medium text-green-dark mb-4">
              <span class="w-2 h-2 rounded-sm bg-green-dark shrink-0"></span>
              What I Worked On
            </h4>
            <div class="flex flex-col gap-3">
              {project.workedOn.map(item => (
                <div class="flex items-start gap-3">
                  <span class="w-1.5 h-1.5 rounded-full bg-neutral-300 shrink-0 mt-2.5"></span>
                  <span class="text-sm text-neutral-600 leading-relaxed">{item}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Design Showcase -->
    {project.designShowcase?.images?.length > 0 && (
      <div class="flex flex-col gap-5">
        <div class="flex flex-col gap-2">
          <h3 class="text-xs font-semibold text-neutral-900 uppercase tracking-widest">Design Showcase</h3>
          {project.designShowcase.subtitle && <p class="text-neutral-500 leading-relaxed text-sm">{project.designShowcase.subtitle}</p>}
        </div>
        <div class="flex flex-col gap-4">
          {project.designShowcase.images.map(img => (
            <figure>
              <div class="rounded-2xl overflow-hidden bg-card">
                <img src={optimizeImage(img.src, 1100)} alt={img.alt} class="w-full" loading="lazy" decoding="async" />
              </div>
              {img.caption && (
                <figcaption class="flex items-center gap-1.5 text-xs text-neutral-400 uppercase tracking-widest pt-3">
                  <span class="w-1 h-1 rounded-full bg-neutral-300 shrink-0"></span>
                  {img.caption}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </div>
    )}

    <!-- The Solution -->
    {project.solution && (
      <div class="rounded-3xl bg-card p-8 flex flex-col gap-5">
        <h3 class="flex items-center gap-2 text-[13px] font-medium text-green-dark">
          <span class="w-2 h-2 rounded-sm bg-green-dark shrink-0"></span>
          The Solution
        </h3>
        <p class="text-neutral-900 leading-relaxed text-base">{project.solution}</p>
      </div>
    )}

    <!-- The Outcome (dark card with testimonial) -->
    {project.outcome?.body && (
      <div class="rounded-2xl p-8 text-white bg-neutral-900 flex flex-col">
        <h4 class="flex items-center gap-2 text-xs font-medium text-white/60 uppercase tracking-widest mb-3">
          <span class="w-2 h-2 rounded-sm bg-orange-500 shrink-0"></span>
          The Outcome
        </h4>
        <p class="text-neutral-300 leading-relaxed mb-6 text-[20px]">{project.outcome.body}</p>
        {project.outcome.quote && (
          <>
            <span class="flex items-center justify-center w-10 h-10 rounded-xl bg-white/10 mb-4">
              <svg width="18" height="18" viewBox="0 0 448 512" fill="currentColor" class="text-orange-500">
                <path d="M0 216C0 149.7 53.7 96 120 96h8c17.7 0 32 14.3 32 32s-14.3 32-32 32h-8c-30.9 0-56 25.1-56 56v8h64c35.3 0 64 28.7 64 64v64c0 35.3-28.7 64-64 64H64c-35.3 0-64-28.7-64-64V320 288 216zm256 0c0-66.3 53.7-120 120-120h8c17.7 0 32 14.3 32 32s-14.3 32-32 32h-8c-30.9 0-56 25.1-56 56v8h64c35.3 0 64 28.7 64 64v64c0 35.3-28.7 64-64 64H320c-35.3 0-64-28.7-64-64V320 288 216z"/>
              </svg>
            </span>
            <p class="text-[20px] leading-relaxed font-medium italic">{project.outcome.quote}</p>
          </>
        )}
        {project.outcome.author && (
          <div class="mt-6">
            <p class="text-sm font-semibold">{project.outcome.author}</p>
            {project.outcome.authorRole && <p class="text-xs text-white/50 mt-0.5 tracking-widest">{project.outcome.authorRole}</p>}
          </div>
        )}
      </div>
    )}

    <!-- Mid-page "Book a free call" CTA -->
    {settings.bookCallUrl && (
      <div class="rounded-3xl bg-card p-8 md:p-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6 my-4">
        <div>
          <p class="font-serif text-3xl text-neutral-900">Like what you see?</p>
          <p class="text-sm text-neutral-500 mt-2">Let's talk about building something like this for your business.</p>
        </div>
        <div class="flex items-center gap-4 shrink-0">
          <a
            href={settings.bookCallUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-neutral-900 text-white text-sm font-medium rounded-full px-6 py-3.5 hover:opacity-90 transition-opacity whitespace-nowrap"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
            Let's have a chat
          </a>
          <a
            href={emailHref}
            class="text-sm text-neutral-500 hover:text-neutral-900 underline transition-colors whitespace-nowrap"
          >
            or email me
          </a>
        </div>
      </div>
    )}

    <!-- Continue exploring my portfolio -->
    {otherCaseStudy && (
      <div class="flex flex-col gap-6">
        <p class="text-center text-sm text-neutral-400">Continue exploring my portfolio</p>
        <CaseStudyCard
          slug={otherCaseStudy.slug}
          title={otherCaseStudy.title}
          description={otherCaseStudy.description}
          coverImage={otherCaseStudy.coverImage}
          coverAlt={otherCaseStudy.coverAlt}
          index={1}
        />
      </div>
    )}

  </div>

</Layout>

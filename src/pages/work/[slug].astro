---
import Layout from '../../layouts/Layout.astro';
import { getCaseStudies } from '../../data/projects';

const { slug } = Astro.params;
const caseStudies = await getCaseStudies();
const project = caseStudies.find(p => p.slug === slug);

if (!project) return Astro.redirect('/404');

const projectTitle = project.title.replace('\n', ' ');
const projectDescription = project.description || project.tags;
const rawCardColor = project.cardColor?.trim();
const cardColor = rawCardColor
  ? (rawCardColor.startsWith('#') ? rawCardColor : `#${rawCardColor}`)
  : '#3D5A20';

const creativeWorkJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: projectTitle,
  description: projectDescription,
  creator: {
    '@type': 'Person',
    name: 'Labi Joshua',
    url: 'https://labijoshua.com',
  },
  image: project.coverImage,
  url: `https://labijoshua.com/work/${project.slug}`,
  ...(project.websiteUrl ? { mainEntityOfPage: project.websiteUrl } : {}),
};
---

<Layout
  title={`${projectTitle} — Joshua Owolabi`}
  description={projectDescription}
  ogImage={project.coverImage}
  ogImageAlt={project.coverAlt}
  ogType="article"
  ctaColor={cardColor}
  showNav={false}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(creativeWorkJsonLd)} />

  <!-- Go back: fixed pill, hovering inside the hero image, aligned to the max-width container -->
  <div class="fixed top-5 md:top-6 inset-x-0 z-[60] px-6 max-w-[1100px] mx-auto w-full flex justify-end pointer-events-none">
    <a
      href="/"
      class="pointer-events-auto flex items-center gap-1 rounded-full bg-black/25 backdrop-blur-lg border border-white/20 shadow-lg p-1.5 m-4 text-white text-sm font-medium hover:bg-black/35 transition-colors"
    >
      <span class="flex items-center justify-center w-10 h-10 rounded-full bg-white/10 border border-white/20 shrink-0">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M12 7H2M2 7L6 3M2 7L6 11" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="pr-4 whitespace-nowrap">Go Back</span>
    </a>
  </div>

  <div class="flex flex-col gap-9 pt-16 pb-20">

    <!-- Product preview hero — framed mockup card(s) on a light background -->
    {project.previewImages?.length > 0 && (
      <section class="px-6 max-w-[1100px] mx-auto w-full">
        <div class="relative w-full rounded-3xl bg-card overflow-hidden" style="aspect-ratio: 2.6 / 1; min-height: 224px;">
          {project.previewImages[1] && (
            <div class="absolute rounded-xl overflow-hidden shadow-lg bg-white" style="width: 55%; right: 4%; top: 20%; z-index: 1;">
              <img src={project.previewImages[1].src} alt="" class="w-full h-full object-cover" loading="eager" />
            </div>
          )}
          <div
            class="absolute overflow-hidden bg-white"
            style={project.previewImages[1]
              ? 'width: 58%; left: 6%; top: 28%; z-index: 2; border-radius: 0.75rem; box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);'
              : 'inset: 0; z-index: 2;'}
          >
            <img
              src={project.previewImages[0].src}
              alt={project.previewImages[0].alt}
              class="w-full h-full object-cover"
              loading="eager"
            />
          </div>
        </div>
      </section>
    )}

    <!-- Two-column layout -->
    <div class="px-6 max-w-[1100px] mx-auto w-full grid grid-cols-1 md:grid-cols-[348px_1fr] gap-10 md:gap-16 items-start">

    <!-- Left sidebar -->
    <aside class="hidden md:flex md:sticky md:top-6 flex-col gap-6">

      <!-- Info card — background color set per-project in Sanity (cardColor); the whole sidebar is hidden on mobile, Visit Website button moves to the bottom of the page there -->
      <div class="rounded-2xl p-6 text-white" style={`background-color: ${cardColor};`}>
        <h2 class="font-serif text-2xl font-normal leading-snug whitespace-pre-line" style="color: #F3F5F0;">{project.title}</h2>
        {project.description && <p class="text-sm text-white/75 mt-2 leading-relaxed">{project.description}</p>}
        {project.websiteUrl && (
          <a
            href={project.websiteUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="visit-btn mt-5 flex items-center justify-center gap-2 rounded-full px-4 py-4 text-sm font-medium w-full"
            style={`background-color: #F7F7F7; color: ${cardColor};`}
          >
            Visit Website
            <span class="btn-arrow-wrap">
              <span class="btn-arrow-out">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2 10L10 2M10 2H5M10 2V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
              <span class="btn-arrow-in">
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M2 10L10 2M10 2H5M10 2V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </span>
          </a>
        )}
      </div>

      <!-- Metadata -->
      <div class="flex flex-col gap-5 text-sm">
        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-2">Role</p>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green shrink-0"></span>
            <span class="text-neutral-700">{project.role}</span>
          </div>
        </div>

        {project.technicalSpecs?.length > 0 && (
          <div>
            <p class="text-xs text-neutral-400 uppercase tracking-widest mb-2">Technical Specs</p>
            <div class="flex flex-col gap-1.5">
              {project.technicalSpecs.map(spec => (
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-green shrink-0"></span>
                  <span class="text-neutral-700">{spec}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <div>
          <p class="text-xs text-neutral-400 uppercase tracking-widest mb-2">Status</p>
          <span class="text-neutral-900 font-medium">{project.status}</span>
        </div>
      </div>
    </aside>

    <!-- Right content -->
    <div class="flex flex-col gap-14">
      {project.sections?.map((section) => (
        <div class="flex flex-col gap-5">
          <h3 class="text-2xl font-serif font-medium text-neutral-900">{section.heading}</h3>
          <p class="text-neutral-600 leading-relaxed text-base">{section.body}</p>

          {section.images && section.images.length > 0 && (
            <div class="flex flex-col gap-4 mt-2">
              {section.images.map(img => (
                <figure class="rounded-2xl overflow-hidden bg-card">
                  <img
                    src={img.src}
                    alt={img.alt}
                    class="w-full"
                    loading="lazy"
                  />
                  {img.caption && (
                    <figcaption class="text-xs text-neutral-400 text-center py-3 px-4">
                      {img.caption}
                    </figcaption>
                  )}
                </figure>
              ))}
            </div>
          )}

          {/* Testimonial card — injected after "The Solution" section */}
          {project.testimonial && section.showQuoteAfter && (
            <div class="rounded-2xl p-8 text-white mt-4" style={`background-color: ${cardColor};`}>
              <p class="text-base leading-relaxed font-medium italic">{project.testimonial.quote}</p>
              <div class="mt-6 flex items-center justify-between">
                <div>
                  <p class="text-sm font-semibold">{project.testimonial.author}</p>
                  <p class="text-xs text-white/70 mt-0.5">{project.testimonial.authorRole}</p>
                </div>
                <span class="text-xs text-white/50">{project.testimonial.company}</span>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

  </div>

  {project.websiteUrl && (
    <div class="md:hidden px-6 max-w-[1100px] mx-auto w-full">
      <a
        href={project.websiteUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="visit-btn flex items-center justify-center gap-2 rounded-full px-4 py-4 text-sm font-medium w-full"
        style={`background-color: ${cardColor}; color: #F7F7F7;`}
      >
        Visit Website
        <span class="btn-arrow-wrap">
          <span class="btn-arrow-out">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2 10L10 2M10 2H5M10 2V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="btn-arrow-in">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M2 10L10 2M10 2H5M10 2V7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </span>
      </a>
    </div>
  )}

  </div>

</Layout>

<style>

  .visit-btn {
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .visit-btn:active {
    transform: scale(0.97);
  }
  .btn-arrow-wrap {
    display: inline-flex;
    position: relative;
    overflow: hidden;
    width: 12px;
    height: 12px;
  }
  .btn-arrow-out,
  .btn-arrow-in {
    display: inline-flex;
    position: absolute;
    top: 0; left: 0;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease;
  }
  .btn-arrow-in {
    transform: translate(-6px, 6px);
    opacity: 0;
  }
  .visit-btn:hover .btn-arrow-out {
    transform: translate(6px, -6px);
    opacity: 0;
  }
  .visit-btn:hover .btn-arrow-in {
    transform: translate(0, 0);
    opacity: 1;
  }
</style>

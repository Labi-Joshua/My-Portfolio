---
import { optimizeImage } from '../lib/image';

interface Props {
  slug: string;
  title: string;
  description?: string;
  coverImage: string;
  coverAlt: string;
  index: number;
}

const { slug, title, description, coverImage, coverAlt, index } = Astro.props;

const isGif = /\.gif(\?|$)/i.test(coverImage);
const animatedSrc = optimizeImage(coverImage, 700, { autoFormat: false });
const staticFrame = isGif
  ? `${coverImage}${coverImage.includes('?') ? '&' : '?'}fm=jpg&w=700&q=75`
  : optimizeImage(coverImage, 700);
---

<a
  href={`/work/${slug}`}
  class="group card-hover flex flex-col md:flex-row rounded-3xl overflow-hidden h-fit w-full"
>
  <!-- Text content -->
  <div class="p-8 md:w-1/2 md:shrink-0 md:p-10 flex flex-col">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-green-dark inline-block shrink-0"></span>
      <span class="text-[13px] font-medium text-neutral-500 tracking-wide">Case Study</span>
    </div>
    <div class="flex flex-col justify-center mt-16 md:mt-0 md:flex-1">
      <h3 class="font-serif text-[32px] font-normal leading-tight text-neutral-900 whitespace-pre-line">{title}</h3>
      {description && <p class="text-sm text-neutral-500 leading-relaxed mt-3 max-w-xs line-clamp-3">{description}</p>}
      <span class="text-sm text-green font-medium group-hover:gap-2.5 flex items-center gap-1.5 transition-all mt-4">
        Read the case study
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
          <path d="M2.5 6h7M6 2.5L9.5 6 6 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    </div>
  </div>

  <!-- Image: mobile only (bottom, ExperimentCard style) — gif animates by default on mobile -->
  <div class="md:hidden mx-3 mb-3 mt-4 rounded-2xl overflow-hidden h-[214px] relative">
    <img
      src={animatedSrc}
      alt={coverAlt}
      class="w-full h-full object-cover object-top"
      loading={index === 0 ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>

  <!-- Image: tablet and above (right side, responsive) -->
  <div class="hidden md:block shrink-0 self-start" style="width: 50%; padding: 12px 12px 12px 0;">
    <div class="relative" style="width: 100%; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 16px;">
      <img
        src={animatedSrc}
        alt={coverAlt}
        class="w-full h-full object-cover object-top"
        loading={index === 0 ? 'eager' : 'lazy'}
        decoding="async"
      />
      {isGif && (
        <img
          src={staticFrame}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 w-full h-full object-cover object-top pointer-events-none transition-opacity duration-300 group-hover:opacity-0"
          loading={index === 0 ? 'eager' : 'lazy'}
        />
      )}
    </div>
  </div>
</a>

---
interface Props {
  name?: string;
  headline?: string;
  bookCallUrl?: string;
  contactHref?: string;
  resumeHref?: string;
}

const {
  name = 'Joshua',
  headline = 'a Product Designer partnering with teams to create solutions that work for users.',
  bookCallUrl,
  contactHref = 'mailto:hello@joshuaowolabi.com',
  resumeHref = '/resume.pdf',
} = Astro.props;
---

<section class="pt-16 pb-20 px-6 text-center max-w-3xl mx-auto">
  <h1 class="font-serif text-5xl md:text-[56px] leading-[1.15] tracking-tight text-neutral-900">
    <span class="text-neutral-400">Hi, I'm {name},</span> {headline}
  </h1>

  <div class="flex items-center justify-center gap-6 mt-10 flex-wrap -translate-x-3">
    <a
      href={bookCallUrl || contactHref}
      target={bookCallUrl ? '_blank' : undefined}
      rel={bookCallUrl ? 'noopener noreferrer' : undefined}
      class="inline-flex items-center gap-2 bg-neutral-900 text-white text-sm font-medium rounded-full px-7 py-4 hover:opacity-90 transition-opacity whitespace-nowrap"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.362 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.338 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      Let's have a chat
    </a>
    <a
      href={resumeHref}
      target="_blank"
      rel="noopener noreferrer"
      class="text-sm text-neutral-700 hover:text-neutral-900 transition-all flex items-center gap-1.5 hover:gap-2.5 group whitespace-nowrap"
    >
      See my resume
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform group-hover:translate-x-0.5">
        <path d="M2.5 7h9M7 2.5L11.5 7 7 11.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</section>
